      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take two deep breaths. Then let me sleep."
          }
        }
      }
    },
    "Fai le fusa: un respiro lungo dal naso, fuori piano dalla bocca.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purr: a long breath in through the nose, slowly out through the mouth."
