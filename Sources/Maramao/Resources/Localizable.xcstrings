        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the name of a shortcut from the Shortcuts app (e.g. \"Pause music\"). It gets a small JSON input with the event, phase and cat. If the shortcut doesn't exist, Maramao just ignores it."
          }
