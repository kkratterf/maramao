        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 Enough! I'm trying to sleep!"
          }
        }
      }
    },
    "😾 HSSSS!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 HSSSS!"
          }
        }
      }
    },
    "😾 L'hai svegliato!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 You woke it up!"
          }
        }
      }
    },
    "😾 Mani lontane dalla tastiera. Subito.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 Hands off the keyboard. Now."
          }
        }
      }
    },
    "😾 Mi siedo sulla tastiera, giuro.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 I will sit on the keyboard. I swear."
          }
        }
      }
    },
    "😾 Pausa vuol dire PAUSA, umano.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 Break means BREAK, human."
          }
        }
      }
    },
    "😾 Stanotte ti miagolo alle quattro.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 Tonight I'm meowing at 4 a.m."
          }
        }
      }
    },
    "😾 Sto contando fino a nove. Come le mie vite.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 I'm counting to nine. Like my lives."
          }
        }
      }
    },
    "😾 Un'altra mossa e ti butto il caffè dalla scrivania.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😾 One more move and your coffee goes off the desk."
          }
        }
      }
    },
    "Pacchetti di gatti": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cat packs"
          }
        }
      }
    },
    "Nessun pacchetto installato. Metti una cartella con un file pack.json in Maramao/Cats e premi Ricarica.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No packs installed. Put a folder with a pack.json file in Maramao/Cats and press Reload."
          }
        }
      }
