    "Fuori orario la ripartenza automatica dopo la pausa è spenta e \"Pausa per…\" non fa ripartire il timer. %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside working hours the timer won't restart on its own after a break, and \"Pause for…\" won't restart it either. %@."
          }
        }
      }
    },
    "Fuori orario: niente partenze automatiche": {
