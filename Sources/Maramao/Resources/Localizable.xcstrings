    "Allunga le dita all'indietro, una mano alla volta, per dieci secondi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently bend your fingers back, one hand at a time, for ten seconds."
          }
        }
      }
    },
    "Alzati e gira per la stanza come se fosse tua.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get up and patrol the room like you own it."
